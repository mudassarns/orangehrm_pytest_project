# Copy to .env and replace every placeholder before starting Docker or tests.
# Local OrangeHRM test environment. Do not put real credentials in this template.

# MariaDB container initialization.
# Keep these three password values the same to mirror the existing CI installer setup.
MARIADB_ROOT_PASSWORD=replace_with_local_db_password
MARIADB_DATABASE=
MARIADB_USER=orangehrm
MARIADB_PASSWORD=replace_with_local_db_password

# Selenium framework configuration (Config.get uses the QA_ prefix).
QA_ORANGEHRM_BASE_URL=http://localhost:8080
QA_ORANGEHRM_USERNAME=Admin
QA_ORANGEHRM_PASSWORD=replace_with_local_admin_password

# The framework test process runs on the host, so use the published localhost port.
QA_DB_HOST=127.0.0.1
QA_DB_PORT=3306
QA_DB_NAME=orangehrm
QA_DB_USER=root
QA_DB_PASSWORD=replace_with_local_db_password
